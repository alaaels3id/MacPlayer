{
  "name": "macplayer",
  "version": "1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:all": "electron-vite build && electron-builder -mw",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:all": "electron-vite build && electron-builder -mw",
    "postinstall": "electron-builder install-app-deps",
    "test": "npx tsx test/parsers.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "MacPlayer - Modern Video Player for macOS and Windows",
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.macplayer.app",
    "productName": "MacPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MacPlayer"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "MPEG-4 Video",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "Apple QuickTime Movie",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "Audio Video Interleave Video",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Matroska Video",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "Apple MPEG-4 Video",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "role": "Viewer"
      }
    ]
  }
}
